# XIAO ESP32S3 Sense: 8MB flash + octal 8MB PSRAM (N8R8)
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_240=y
# Console on the native USB-Serial/JTAG CDC port (/dev/cu.usbmodem*)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# Custom table: 3MB app partition (default single-app is 1MB)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# INGEST_BASE is http://sleepy.local:8077 — .local needs mDNS queries.
# Without this line a clean build silently fails every upload (the setting
# had lived only in a generated sdkconfig before 2026-11-07).
CONFIG_LWIP_DNS_SUPPORT_MDNS_QUERIES=y
