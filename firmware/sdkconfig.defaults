# XIAO ESP32S3 Sense: 8MB flash + octal 8MB PSRAM (N8R8)
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_240=y
# Console on the native USB-Serial/JTAG CDC port (/dev/cu.usbmodem*)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# Deep-sleep duty cycling: skip bootloader image validation on timer wake
# (result cached in RTC memory) — shaves ~100 ms off every wake burst.
CONFIG_BOOTLOADER_SKIP_VALIDATE_IN_DEEP_SLEEP=y
