# Copy to .env (gitignored). run.sh sources it before starting uvicorn.

# AI: Jev decision model on OpenRouter (see ingest/jev.py).
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=put-y…here

# Optional overrides (defaults compiled into jev.py):
# JEV_MODEL=typesafe/jev-1.14   # Box needs 1.14+; ~typesafe/jev-latest also works
# JEV_BIRD_P=0.5                # P(bird) >= this => bird_identified; tune on labeled frames

# Optional:
# INGEST_DATA=/abs/path/to/photo/store   # default: ingest/data
# PORT=8077

# ntfy bird alerts (see ingest/notify.py): one push per frame on its first
# bird verdict. Create a topic at ntfy.sh and put its name here; empty = off.
# NTFY_TOPIC=put-your-topic-here
# NTFY_SERVER=https://ntfy.sh            # default
# INGEST_PUBLIC_URL=http://sleepy.tail643d2.ts.net:8077
#   # the tap target for the alert: the frame's URL. Must be reachable from
#   # the phone that subscribes (tailnet URL). No inline image attach: ntfy.sh
#   # 414s the ~5 KB URI a small thumbnail needs (measured 2026-11-02).
